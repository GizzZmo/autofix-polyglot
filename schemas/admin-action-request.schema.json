{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GizzZmo/autofix-polyglot/schemas/admin-action-request.schema.json",
  "title": "AdminActionRequest",
  "description": "Phase 7B supervised write. Auth is transport-level (Bearer ADMIN_TOKEN); actor is recorded for audit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "actor", "reason"],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "link.requeue",
        "link.override",
        "circuit.reset",
        "discovery.pause",
        "discovery.resume"
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Human or service identity (not a secret)."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "urls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "string", "format": "uri", "minLength": 1 }
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "HEALED", "DEAD", "HEALTHY"]
    },
    "resolved_url": {
      "type": "string",
      "format": "uri"
    },
    "circuit_name": {
      "type": "string",
      "enum": ["healer_wayback", "edge_healer"]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "link.requeue" } }, "required": ["action"] },
      "then": { "required": ["urls"] }
    },
    {
      "if": { "properties": { "action": { "const": "link.override" } }, "required": ["action"] },
      "then": { "required": ["urls", "status"] }
    },
    {
      "if": { "properties": { "action": { "const": "circuit.reset" } }, "required": ["action"] },
      "then": { "required": ["circuit_name"] }
    }
  ]
}
