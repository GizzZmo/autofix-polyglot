{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GizzZmo/autofix-polyglot/schemas/link-record.schema.json",
  "title": "LinkRecord",
  "type": "object",
  "required": ["status", "original_url"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PENDING", "HEALED", "DEAD", "HEALTHY"]
    },
    "original_url": { "type": "string", "format": "uri" },
    "resolved_url": { "type": "string", "format": "uri" },
    "discovered_at": { "type": "string", "format": "date-time" },
    "healed_at": { "type": "string", "format": "date-time" },
    "reason": { "type": "string" }
  },
  "additionalProperties": false
}
